#include <stdio.h>
#include <ctype.h>

#define MAXLINE 1000 /* maximum input line length */
int getlineKR(char line[], int maxline);
void expandMS(char s1[], char s2[]);

int main()
{
    int len; /* current line length */
    char line[MAXLINE]; /* current input line */
    while ((len = getlineKR(line, MAXLINE)) > 0)
    {
	char expanded_line[MAXLINE];
	expandMS(line, expanded_line);
	printf("Expand: %s\n", expanded_line);
    }

    return 0;
}

/* getline: read a line into s, return length */
int getlineKR(char s[],int lim)
{
    int c, i;
    for (i=0; i < lim-1 && (c=getchar())!=EOF && c!='\n'; ++i)
    s[i] = c;
    if (c == '\n') {
	s[i] = c;
	++i;
    }
    s[i] = '\0';
    return i;
}

void expandMS(char s1[], char s2[])
{
    int expand_flag = 0;

    int i = 0;
    int j = 0;
    int k = 1;
    int l;
    while (k != '\0')
    {
	if (isalnum(s1[i]) && s1[k] == '-')
	{
	    k++;

	    if (s1[k] == '\0')
	    {
		s2[j++] = '-';
		break;
	    }
	    
	    for (l = s1[i]; l < s1[k]; l++)
	    s2[j++] = s1[l];

	    i = k;
	    k++;
	}
	else
	{
	    s2[j++] = s1[i++];
	    k++;
	}
    }

    s2[j] = '\0';
}

    
	



	

	

	

	

