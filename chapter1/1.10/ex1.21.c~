#include <stdio.h>

// Symbolic contants
#define MAXLINE 1000 /* maximum input line length */
#define TABSTOP 4

// Extern declarations
int i, j, spaces,  col;


// Function declartions
int getlineKR(char line[], int maxline);
void copy(char to[], char from[]);
void entab(char line[]);


