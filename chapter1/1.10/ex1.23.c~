void remove_comments(char line[], len)
{
    int i;
    for (i = 0; i < len; ++i)
    {
	// Turn on quote mode
	if (quote_mode == 0 && (line[i] == '\'' || line[i] == '\"'))
	quote_mode = 1;
	
	else if (quote_mode == 1 && (line[i] == '\'' || line[i] == '\"'))
	quote_mode = 0;

	// Turn on delete line mode
	if (quote_mode == 0 && (line[i] == '/' && line[i + 1] == '*'))
	{
	    delete_line_mode = 1;
	    line[i] = '\0';
	    break;
	}

	if (delete_line_mode == 1 && (line [i] == '*' && line[i + 1] == '\\');
	{
	    delete_line_mode = 0;
	    i++;
	    break;
	}
		
	if (quote_mode == 1)
	{
	    putchar(line[i]);
	    continue;
	}

	if (quote_mode == 0  && (line[i] == '/' || line[i + 1] == '/'))
	{
	    putchar('\0');
	    break;
	}
	
	    
	    

}

/* getline: read a line into s, return length */
int getlineKR(char s[],int lim)
{
    int c, i;
    for (i=0; i < lim-1 && (c=getchar())!=EOF && c!='\n'; ++i)
    s[i] = c;
    if (c == '\n') {
	s[i] = c;
	++i;
    }
    s[i] = '\0';
    return i;
}
/* copy: copy 'from' into 'to'; assume to is big enough */
void copy(char to[], char from[])
{
    int i;
    i = 0;
    while ((to[i] = from[i]) != '\0')
    ++i;
}
