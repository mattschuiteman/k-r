/* getline: read a line into s, return length */
int getlineKR(char s[],int lim)
{
    int c, i;
    for (i=0; i < lim-1 && (c=getchar())!=EOF && c!='\n'; ++i)
    s[i] = c;
    if (c == '\n') {
	s[i] = c;
	++i;
    }
    s[i] = '\0';
    return i;
}

void squeezeKR(char s1[], char s2[])
{
    int i, j, k, found;

    for (i = j = 0; s1[i] != '\0'; i++)
    {
	found = 0;

	for (k = 0; s2[k] != '\0'; k++)
	{
	    if (s1[i] == s2[k])
	    found = 1;
	}

	if (!found)
	s1[j++] = s1[i];
    }

    s1[j] = '\0';
}

int anyMS(char s1[], char s2[])
{
    int i, k, found;

    for (i = 0; s1[i] != '\0'; i++)
    {
	found = -1;

	for (k = 0; s2[k] != '\0'; k++)
	{
	    if (s1[i] == s2[k])
	    {
		found = i;
		break;
	    }
	}
    }
    
	
	
    
